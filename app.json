{
  "expo": {
    "name": "BackFire",
    "slug": "backfire",
    "scheme": "backfire",
    "version": "1.0.7",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/BF in game logo safe.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EBE3"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.playbackfire.app",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "androidStatusBar": {
      "hidden": true
    },
    "android": {
      "versionCode": 38,
      "package": "com.playbackfire.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0EBE3"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "clerk",
              "host": "com.playbackfire.app.callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.playbackfire.app",
              "host": "callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EBE3",
          "image": "./assets/BF in game logo safe.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F0EBE3",
            "image": "./assets/BF in game logo safe.png"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.revenuecat.purchases.** { *; }\n-dontwarn com.revenuecat.purchases.**"
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed21e462-752d-4c84-b233-c0fa0b48be25"
      }
    },
    "owner": "mikhailspeaks"
  }
}
