{
  "name": "backfire",
  "version": "1.0.7",
  "description": "Competitive multiplayer trivia — pick categories, split into teams, and outscore your rivals on a shared board.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --localhost",
    "android": "expo run:android",
    "android:standalone": "EAS_BUILD_PROFILE=local-standalone node scripts/patch-standalone-debug-bundle.mjs && expo run:android --no-bundler",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "vercel-build": "bun run build:web",
    "guard:clerk-sso": "jest __tests__/lib/clerkNativeSsoContract.test.ts --runInBand",
    "build:android:prod": "bash -lc 'bun run guard:clerk-sso && set -a && source .env.production && set +a && export GRADLE_USER_HOME=\"$HOME/.gradle\" && export ANDROID_HOME=\"/Volumes/Mikhail Seagate 2TB SSD/AndroidDev/sdk\" && export ANDROID_SDK_ROOT=\"/Volumes/Mikhail Seagate 2TB SSD/AndroidDev/sdk\" && eas build --platform android --profile production --local'",
    "build:ios:prod": "bash -lc 'bun run guard:clerk-sso && bash scripts/build-ios-prod.sh'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eas-build-post-install": "node scripts/patch-standalone-debug-bundle.mjs && bun run guard:clerk-sso",
    "lint": "eslint . && oxlint -c oxlint.config.mjs .",
    "seed:import": "tsx scripts/import-questions-from-csv.ts && tsx scripts/merge-picture-topics.ts && tsx scripts/normalize-questions.ts",
    "seed:normalize": "tsx scripts/normalize-questions.ts",
    "seed:translations:check": "tsx scripts/check-translations.ts",
    "topics:picture:prepare": "python3 scripts/prepare-picture-topic-assets.py",
    "topics:picture:merge": "tsx scripts/merge-picture-topics.ts && tsx scripts/normalize-questions.ts",
    "seed:push": "tsx scripts/push-seed-to-convex.ts",
    "seed:push:prod": "tsx scripts/push-seed-to-convex.ts --prod",
    "topics:transparent": "python3 scripts/transparency-topic-images.py",
    "topics:optimize": "python3 scripts/optimize-topic-images.py",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "keywords": [
    "expo",
    "react-native",
    "template",
    "typescript",
    "navigation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mwijanarko1/doubledown"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "expo-modules-core@55.0.22": "patches/expo-modules-core@55.0.22.patch"
  },
  "license": "MIT",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.30",
    "@clerk/clerk-react": "5.61.3",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo/metro-runtime": "~55.0.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@revenuecat/purchases-js": "1.42.4",
    "convex": "^1.19.0",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.24",
    "expo-apple-authentication": "~55.0.15",
    "expo-auth-session": "~55.0.16",
    "expo-build-properties": "~55.0.0",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-screen-orientation": "~55.0.15",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-purchases": "^10.7.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.17",
    "oxlint": "1.79.0",
    "react-test-renderer": "19.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  },
  "private": false
}
